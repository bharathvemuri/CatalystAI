# Copy to .env (gitignored) and fill in. Values here are read by the harness
# only; nothing in this file is ever printed, logged, or written to state.
#
# Lookup order for every variable below:
#   1. the process environment
#   2. <target-repo>/.env      <- per project, this file's usual home
#   3. ~/.ai-harness/.env      <- one credential across every project
#
# Tracker credential for `harness setup-project`. Needs the 'repo' scope.
# Optional if the GitHub CLI is logged in: `gh auth token` is used as a fallback.
GITHUB_TOKEN=

# The harness makes its own model calls. `ant auth login` works instead of this.
ANTHROPIC_API_KEY=
